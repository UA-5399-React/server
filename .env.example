# MongoDB Connection String
# You can find the real credentials in our shared Google Sheet on Env page.
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<your_name_db>?appName=SoftServe-Academy
# IMPORTANT: Replace "your_name_db" with your actual name (e.g., vasya_db, oleg_db)
# This ensures everyone has their own isolated database in the shared cluster for local debugging
DB_CONNECTION_LINK=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_URL>/<your_name_db>?appName=SoftServe-Academy